[Unit]
Description=Atlas GPU Reliability Test Server (8077)
After=network.target

[Service]
Type=simple
WorkingDirectory=/ops/atlas-test
ExecStart=/ops/atlas-test/atlas-server --config /ops/atlas-test/config.test.yaml
Restart=always
RestartSec=3
User=root
Environment=ATLAS_PORT=8077
Environment=ATLAS_WEB_DIR=/ops/atlas-test/web-current
EnvironmentFile=-/ops/atlas-test/atlas-secrets.env
Environment=ATLAS_NODE_CREDENTIAL_ALLOW_INSECURE_LOOPBACK=true
Environment=ATLAS_NODE_CREDENTIAL_ALLOW_INSECURE_HTTP=true

[Install]
WantedBy=multi-user.target
