[Unit]
Description=Atlas PostgreSQL 17 (Native)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=postgres
Group=postgres
RuntimeDirectory=atlas-postgres
RuntimeDirectoryMode=0700
ExecStart=/usr/lib/postgresql/17/bin/postgres -D /ops/atlas/postgres-data -p 15432 -c listen_addresses=127.0.0.1 -c unix_socket_directories=/run/atlas-postgres -c max_connections=50
KillSignal=SIGINT
TimeoutStopSec=60
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
