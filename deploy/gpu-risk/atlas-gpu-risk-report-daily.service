[Unit]
Description=Atlas GPU risk daily read-only report
After=atlas.service

[Service]
Type=oneshot
EnvironmentFile=/etc/atlas/atlas.env
# $$ is systemd's escape for a literal $: bash, not systemd, expands the DSN,
# so it never appears in the process argv.
ExecStart=/bin/bash -c 'ATLAS_GPU_RISK_DSN="$$ATLAS_DATABASE_DSN" exec /ops/atlas/gpu-risk report -kind daily -out /ops/atlas/reports/gpu-risk -notify'
Nice=10
TimeoutStartSec=15min
